# ─────────────────────────────────────────────────────────────
# AI SEO Analyzer — 환경변수 설정
# 이 파일을 .env 로 복사한 뒤 실제 키를 입력하세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# ── SEO 분석 엔진 ────────────────────────────────────────────
# Gemini — 사이트 SEO 분석 (필수)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── GEO 모니터링 엔진 (AI 인용률 실측) ───────────────────────
# 최소 1개 이상 설정하면 해당 엔진만 측정됩니다.

# Perplexity — citations[] 실제 인용 URL 추출 지원 (권장)
# 발급: https://www.perplexity.ai/settings/api
PPLX_API_KEY=

# OpenAI (ChatGPT)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude) — GEO 측정 + 질의 자동 생성(P2-2)에 사용
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 네이버 CLOVA Studio (HyperCLOVA X) — 한국 시장 특화 (P2-1)
# 발급: https://clovastudio.ncloud.com → 테스트 앱 생성 후 API 키 발급
# 형식: nv-xxxxxxxx...
NAVER_CLOVA_API_KEY=
